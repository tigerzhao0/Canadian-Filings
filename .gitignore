# Real config with API keys — never commit (config.example.yaml is the template)
config.yaml

# SQLite output database(s)
*.db
*.db-journal
*.db-wal
*.db-shm

# Cached SEC EDGAR ticker index (re-downloaded weekly)
.sec_company_tickers.json

# Generated output (regenerated from the DBs any time) — keep the folder, not the files
output/companies/
output/*.html
output/*.xlsx

# The QuoteMedia direct-financials-API pipeline (run.py --financials /
# --with-financials, financials_pipeline.py + tmx_financials.py) is DISABLED
# -- the PDF-extraction pipeline (pdf_financials.db / pdf_financials_xlsx/)
# is the one in active use. Code is kept for reference; its output isn't.
# (This dir also happened to contain two tickers, AUX and PRN, that match
# Windows reserved device names like CON/NUL/COM1 -- no path component named
# that, with ANY extension, can be opened via the normal Win32 file API, and
# Git for Windows refuses to index such a path even via `git update-index
# --cacheinfo` -- un-committable from any Windows machine regardless.)
output/financials_xlsx/
# (output/financials.db itself is already caught by the *.db rule above)

# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# OS cruft
.DS_Store
Thumbs.db
